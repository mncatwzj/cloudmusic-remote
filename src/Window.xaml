<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="随手控" Width="920" Height="820" MinWidth="510" MinHeight="490" WindowStartupLocation="CenterScreen" Background="#212121" Foreground="#ECECEC" FontFamily="Microsoft YaHei UI" FontSize="13">
<Window.Resources>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="#212121"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#525252" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#E6E6E6"/><Setter Property="Background" Value="#303030"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="RenderTransformOrigin" Value=".5,.5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To=".95" Duration="0:0:.08"/><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To=".95" Duration="0:0:.08"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:.18"/><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#272727"/><Setter Property="BorderBrush" Value="#414141"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="22"/></Style>
 <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarWidth" Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#171717" Padding="15,25"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Brand" Text="♪  随手控" FontSize="21" FontWeight="SemiBold" Margin="9,0,0,32"/><Button x:Name="Overview" Content="总览" Style="{StaticResource Nav}" Background="#333333"/><Button x:Name="MouseNav" Content="鼠标侧键" Style="{StaticResource Nav}"/><Button x:Name="KeysNav" Content="快捷键" Style="{StaticResource Nav}"/><Button x:Name="PhoneNav" Content="手机连接" Style="{StaticResource Nav}"/></StackPanel><TextBlock x:Name="SideFooter" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Foreground="#777777" FontSize="10" Text="OpenAI Codex 编写&#10;1.0.0"/></DockPanel></Border>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><Border BorderBrush="#343434" BorderThickness="0,0,0,1" Padding="27,0"><Grid><TextBlock Text="随手控  /  总览" VerticalAlignment="Center" Foreground="#BBBBBB"/><TextBlock Text="●  服务已启动" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A9C6B8" FontSize="10"/></Grid></Border>
 <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Body" Margin="30,27" MaxWidth="850"><TextBlock Text="YOUR MUSIC, WITHIN REACH" FontSize="9" Foreground="#888888" Margin="0,0,0,12"/><TextBlock Text="音乐，随手掌控。" FontSize="28" FontWeight="Medium"/><TextBlock Text="一个轻巧的桌面工具，连接你的音乐与手机。" Foreground="#999999" Margin="0,10,0,24"/>
 <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="网易云音乐" Foreground="#9D9D9D" FontSize="10"/><TextBlock x:Name="Song" Text="网易云音乐" FontSize="22" Margin="0,9,0,4"/><TextBlock Text="使用你已配置的网易云全局快捷键" Foreground="#888888" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Previous" Content="◀" Background="Transparent" BorderThickness="0" Padding="10"/><Button x:Name="Play" Content="播放 / 暂停" Background="#ECECEC" Foreground="#222222" FontSize="11" Width="94" Height="45" Padding="0" Margin="5,0"/><Button x:Name="Next" Content="▶" Background="Transparent" BorderThickness="0" Padding="10"/></StackPanel></Grid></Border>
 <Border x:Name="ConnectionCard" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="手机连接" FontSize="15"/><TextBlock Text="手机连接同一网络，在浏览器打开下面的地址。" Foreground="#999999" FontSize="11" Margin="0,10"/><TextBox x:Name="Links" IsReadOnly="True" Background="Transparent" Foreground="#DDDDDD" BorderThickness="0" TextWrapping="Wrap"/><TextBlock x:Name="PairCode" FontSize="25" Margin="0,12"/><WrapPanel><Button x:Name="CopyLink" Content="复制配对链接" Margin="0,0,8,8"/><Button x:Name="OpenPhone" Content="打开遥控页" Margin="0,0,8,8"/><Button x:Name="RefreshLinks" Content="刷新地址" Margin="0,0,8,8"/><Button x:Name="AllowPhone" Content="允许手机连接…" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border>
 <TextBlock x:Name="MouseHeading" Text="鼠标侧键" FontSize="15" Margin="0,25,0,13"/>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="用哪个侧键切换下一首？" Margin="0,0,0,13"/>
 <Border Background="#1B1B1B" BorderBrush="#353535" BorderThickness="1" CornerRadius="11" Padding="4"><Grid x:Name="Segments" Height="39"><Border x:Name="Selection" Background="#484848" BorderBrush="#616161" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left"><Border.RenderTransform><TranslateTransform x:Name="SelectionOffset"/></Border.RenderTransform></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Upper" Content="上侧键" Background="Transparent" BorderThickness="0"/><Button x:Name="Lower" Grid.Column="1" Content="下侧键" Background="Transparent" BorderThickness="0"/><Button x:Name="Disabled" Grid.Column="2" Content="禁用" Background="Transparent" BorderThickness="0"/></Grid></Grid></Border>
 <TextBlock x:Name="SideHint" Text="已选择上侧键，按下切换下一首。" Foreground="#9A9A9A" FontSize="11" Margin="0,13,0,0"/></StackPanel></Border>
 <Grid Margin="0,25,0,13"><TextBlock x:Name="KeysHeading" Text="网易云快捷键" FontSize="15"/><Button x:Name="Reset" Content="恢复默认" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#AAAAAA" FontSize="10" Padding="0"/></Grid>
 <Border Style="{StaticResource Card}"><StackPanel><StackPanel x:Name="KeyRows"/><TextBlock Text="点击右侧按钮，然后按下组合键。&#10;与网易云现有的全局快捷键保持一致，无需修改网易云。" Foreground="#8A8A8A" FontSize="10" LineHeight="18" Margin="0,16,0,0"/></StackPanel></Border>
 <Border Background="#282E2B" CornerRadius="10" Padding="13" Margin="0,18,0,0"><TextBlock Text="关闭窗口后仍在托盘运行。右击托盘图标可退出。" Foreground="#A6B8AE" FontSize="10"/></Border>
 </StackPanel></ScrollViewer><TextBlock x:Name="Status" Grid.Row="2" Text="随手控 1.0 · 已就绪" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#929292" FontSize="10"/>
 </Grid></Grid></Window>

